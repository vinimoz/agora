                  line-height: 1.4;
                }
              }

              .child-meta {
                display: flex;
                flex-direction: column;
                gap: 8px;
                min-width: 60px;

                .support-indicator,
                .comment-indicator,
                .children-indicator {
                  display: flex;
                  align-items: center;
                  gap: 6px;
                  font-size: 12px;
                  color: var(--color-text-lighter);
                }
              }
            }
          }
        }
      }

      .no-children {
        text-align: center;
        padding: 40px 20px;
        background: var(--color-background-dark);
        border: 2px dashed var(--color-border);
        border-radius: 12px;

        svg {
