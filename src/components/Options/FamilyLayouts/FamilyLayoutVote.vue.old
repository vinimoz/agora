              left: 8px;
              top: 50%;
              transform: translateY(-50%);
              font-size: 11px;
              font-weight: 600;
            }
          }
        }

        .status-tag {
          font-size: 11px;
          padding: 2px 8px;
          border-radius: 12px;
          text-transform: uppercase;

          &.leading { background: #f6c34320; color: #f6c343; }
          &.selected { background: #42b88320; color: #42b883; }
        }
      }
    }
  }

  .empty-state {
