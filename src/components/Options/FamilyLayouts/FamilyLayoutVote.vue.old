                transition: width 0.5s ease;

                &.fill-leading {
                  background: #f6c343;
                }

                &.fill-selected {
                  background: #42b883;
                }
              }
            }
          }

          .voted-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #42b883;
            font-size: 13px;
            font-weight: 500;
            margin-top: 8px;
            padding: 4px 8px;
            background: rgba(66, 184, 131, 0.1);
