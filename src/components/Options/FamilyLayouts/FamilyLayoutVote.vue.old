          max-height: 300px;
        }
      }
    }

    .ranking-table {
      background: var(--color-main-background);
      border-radius: 16px;
      border: 1px solid var(--color-border);
      overflow: hidden;

      h4 {
        margin: 0;
        padding: 16px 20px;
        background: var(--color-background-dark);
        border-bottom: 1px solid var(--color-border);
